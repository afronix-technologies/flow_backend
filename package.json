{
    "name": "afronix-tracker-backend",
    "version": "0.0.1",
    "description": "Scalable Business Tracking System Backend",
    "author": "Afronix",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
        "start": "nest start",
        "start:auth": "nest start auth-service",
        "start:auth:dev": "nest start auth-service --watch",
        "start:notification": "nest start notification-service",
        "start:notification:dev": "nest start notification-service --watch",
        "start:job": "nest start job-service",
        "start:job:dev": "nest start job-service --watch",
        "start:file": "nest start file-service",
        "start:file:dev": "nest start file-service --watch",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/apps/auth-service/main",
        "lint": "eslint \"{apps,test}/**/*.ts\" --fix",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./apps/auth-service/test/jest-e2e.json",
        "docker:dev": "docker-compose -f docker-compose.yml up --build",
        "docker:prod": "docker-compose -f docker-compose.prod.yml up --build -d",
        "generate:module": "node scripts/generate-module.js",
        "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/auth-service/src/data-source.ts",
        "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/auth-service/src/data-source.ts"
    },
    "dependencies": {
        "@nestjs/bull": "^11.0.4",
        "@nestjs/cache-manager": "^2.1.0",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^11.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/platform-socket.io": "^11.1.12",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^7.1.17",
        "@nestjs/throttler": "^5.2.0",
        "@nestjs/typeorm": "^10.0.1",
        "@nestjs/websockets": "^11.1.12",
        "@types/cookie-parser": "^1.4.10",
        "@types/cron": "^2.0.1",
        "@types/multer": "^2.0.0",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/uuid": "^10.0.0",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "bull": "^4.16.5",
        "cache-manager": "^5.3.2",
        "cache-manager-redis-yet": "^4.1.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "express": "^5.2.1",
        "handlebars": "^4.7.8",
        "helmet": "^6.0.0",
        "nest-winston": "^1.9.4",
        "nodemailer": "^7.0.12",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-microsoft": "^2.1.0",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.0",
        "typeorm": "^0.3.17",
        "uuid": "^13.0.0",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/bull": "^3.15.9",
        "@types/compression": "^1.7.5",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.2",
        "@types/node": "^20.3.1",
        "@types/nodemailer": "^7.0.5",
        "@types/passport-jwt": "^3.0.13",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3",
        "webpack": "^5.90.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}