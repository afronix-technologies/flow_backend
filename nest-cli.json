{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "monorepo": true,
    "root": ".",
    "compilerOptions": {
        "deleteOutDir": true,
        "webpack": true
    },
    "projects": {
        "auth-service": {
            "type": "application",
            "root": "apps/auth-service",
            "entryFile": "main",
            "sourceRoot": "apps/auth-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/auth-service/tsconfig.app.json"
            }
        },
        "notification-service": {
            "type": "application",
            "root": "apps/notification-service",
            "entryFile": "main",
            "sourceRoot": "apps/notification-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/notification-service/tsconfig.app.json"
            }
        },
        "job-service": {
            "type": "application",
            "root": "apps/job-service",
            "entryFile": "main",
            "sourceRoot": "apps/job-service/src",
            "compilerOptions": {
                "tsConfigPath": "apps/job-service/tsconfig.app.json"
            }
        },
        "api": {
            "type": "application",
            "root": ".",
            "entryFile": "main",
            "sourceRoot": "src",
            "compilerOptions": {
                "tsConfigPath": "tsconfig.json"
            }
        }
    }
}